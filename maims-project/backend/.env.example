# Maims E-Commerce Platform – Production Environment Variables
# Copy this file to `.env` and fill in the values that are specific to your deployment.
# Leave empty fields blank if they should default to the safe dev fallback (e.g., DEBUG=False).

# ------------------------------------------------------------------------------
# Django Core
# ------------------------------------------------------------------------------
# SECRET_KEY: A long, random string used for signing cookies and other security‑related
#             operations. In production this MUST NOT be the dev fallback.
#             Example: `os.urandom(24).hex()`
SECRET_KEY=

# DEBUG: Set to "False" (or "0", "no", "off") in production. If DEBUG=False and the
#        SECRET_KEY is the dev fallback, Django will raise ImproperlyConfigured.
DEBUG=False

# ALLOWED_HOSTS: Comma‑separated list of hostnames / domains that this Django instance
#               should serve. For production typically: maims.eu,www.maims.eu
ALLOWED_HOSTS=maims.eu,www.maims.eu

# CSRF_TRUSTED_ORIGINS: Required for secure CSRF handling when DEBUG=False. Must match
#                      the exact scheme + host + optional port (no path).
CSRF_TRUSTED_ORIGINS=https://maims.eu,https://www.maims.eu

# ------------------------------------------------------------------------------
# Database (PostgreSQL – production)
# ------------------------------------------------------------------------------
# DATABASE_URL: Full PostgreSQL connection string. If not set, Django falls back to
#               discrete POSTGRES_* environment variables (see below). This is the
#               recommended single‑line format for cloud deployments (Railway, Render,
#               Heroku, etc.).
DATABASE_URL=

# Discrete DB vars (used only when DATABASE_URL is not set, e.g., Docker Compose).
POSTGRES_DB=maims_db
POSTGRES_USER=maims_user
POSTGRES_PASSWORD=maims_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# DB_CONN_MAX_AGE: Persistent DB connections (seconds). Set e.g. 600 for production.
DB_CONN_MAX_AGE=0

# ------------------------------------------------------------------------------
# Frontend / Storefront
# ------------------------------------------------------------------------------
# FRONTEND_DIST_DIR: Absolute path to the built Vite frontend directory inside the
#                    container (e.g., `/app/static/storefront`). Only used when
#                    DEBUG=False and the frontend is statically served.
FRONTEND_DIST_DIR=/app/static/storefront

# FRONTEND_BASE_URL / BACKEND_BASE_URL: Public origins used by the UI for API calls
#                                          and for “review it in the admin” links.
FRONTEND_BASE_URL=https://maims.eu
BACKEND_BASE_URL=https://api.maims.eu

# ------------------------------------------------------------------------------
# Email (used for order notifications, password reset, admin alerts)
# ------------------------------------------------------------------------------
# EMAIL_HOST: SMTP server host. Gmail is a simple choice for dev / small production.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# EMAIL_HOST_USER / EMAIL_HOST_PASSWORD: If left blank the console email backend is used
# (prints messages to stdout). In production you must set real SMTP credentials.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# DEFAULT_FROM_EMAIL: The address shown in “From” headers for transactional emails.
DEFAULT_FROM_EMAIL=noreply@maims.app

# ADMIN_RECEIVER_EMAIL: Where order notifications (new order, payment received, etc.)
#                       are sent when no WhatsApp/Messenger alert is configured.
ADMIN_RECEIVER_EMAIL=

# Cloudinary media storage (required in production). Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# EMAIL configuration: Render free tier blocks outbound SMTP (ports 25, 465, 587).
# Use console backend for development or integrate a third‑party service (SendGrid, Mailgun, etc.) in production.
EMAIL_BACKEND=console

# Real Live Email Settings Configuration (SMTP settings are only used if EMAIL_BACKEND is not console).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# EMAIL_HOST_USER / EMAIL_HOST_PASSWORD: Only needed for real SMTP.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ------------------------------------------------------------------------------
# Stripe (payments)
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY: Live secret key (starts with sk_live_). Used server‑side to
#                    create PaymentIntents, handle webhooks, and refund orders.
STRIPE_SECRET_KEY=

# STRIPE_PUBLISHABLE_KEY: Publishable key (starts with pk_live_) used in the
#                          frontend to initialise Stripe.js.
STRIPE_PUBLISHABLE_KEY=

# STRIPE_WEBHOOK_SECRET: Signing secret from Stripe Dashboard → Developers → Webhooks.
#                        Mandatory for reliable card order confirmation; otherwise
#                        orders only confirm when the customer returns to the success page.
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# WhatsApp / Facebook Messenger (order notifications)
# ------------------------------------------------------------------------------
# WHATSAPP_WEBHOOK_VERIFY_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_ACCESS_TOKEN
# (if using the official Meta Graph API). This project currently supports the
# “simple text + phone” webhook pattern, so the token fields are optional. The
# contact number appears in the admin UI and in outgoing messages.

# Example for Meta Graph API (uncomment when enabled in Admin → Store settings):
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_verify_token_here
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_ACCESS_TOKEN=EAA...

# ------------------------------------------------------------------------------
# Facebook Page product sync (optional)
# ------------------------------------------------------------------------------
# FACEBOOK_PAGE_ID, FACEBOOK_PAGE_ACCESS_TOKEN, FACEBOOK_APP_SECRET
# Only needed when the shop syncs products from a Facebook Page.

# ------------------------------------------------------------------------------
# LLM / AI Chatbot (optional)
# ------------------------------------------------------------------------------
# LLM_API_KEY: Any OpenAI / Groq / OpenRouter key when the chatbot is enabled.
# LLM_MODEL: Model name (e.g., gpt-4o-mini)
# LLM_BASE_URL: Base URL for non‑OpenAI endpoints

# ------------------------------------------------------------------------------
# Security / Misc
# ------------------------------------------------------------------------------
# SERVE_MEDIA: "True" to let Django serve uploaded images directly (single‑container
#              deployments). Set to "False" when using an object store (S3, Cloudinary).
SERVE_MEDIA=True

# CORS_ALLOW_ALL_ORIGINS / CORS_ALLOWED_ORIGINS: Comma‑separated origins trusted by
#                                               the API (e.g., the frontend domain).
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://maims.eu,https://www.maims.eu,http://localhost:5173

# LOGGING: Override the default INFO level for local debugging.
LOG_LEVEL=INFO

# THROTTLE_* (RATE LIMITS): Override the default DRF throttles for auth, checkout, etc.
# (e.g., "10/min", "30/hour"). Leave empty to keep the code defaults.
THROTTLE_AUTH=
THROTTLE_CHECKOUT=
THROTTLE_NEWSLETTER=
THROTTLE_CHATBOT=

# ------------------------------------------------------------------------------
# Runtime flags (rarely changed)
# ------------------------------------------------------------------------------
# AUTH_TOKEN_MAX_AGE_DAYS: Session token lifetime (days). Default 90.
AUTH_TOKEN_MAX_AGE_DAYS=90

# DEBUG only – enable WhiteNoise auto‑refresh to see static file changes.
WHITENOISE_AUTOREFRESH=False
# Never delete hashed static files (useful when static files live on a CDN).
WHITENOISE_KEEP_ONLY_HASHED_FILES=False

# Example of a custom site-wide announcement banner (shown in admin top bar).
# ANNOUNCEMENT_MESSAGE=\"This is a test deployment. Please report any issues.\"
