# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database - PostgreSQL (required)
# Either a single URL (hosted providers inject this automatically)...
DATABASE_URL=postgresql://maims_user:maims_password@127.0.0.1:5432/maims_db
# ...or the discrete settings below (only used when DATABASE_URL is unset):
# POSTGRES_DB=maims_db
# POSTGRES_USER=maims_user
# POSTGRES_PASSWORD=maims_password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Stripe Keys (get from https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# REQUIRED in production: webhook signing secret (Stripe Dashboard -> Developers -> Webhooks).
# Without it, /api/v1/stripe-webhook/ refuses all requests (unsigned events are rejected).
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
