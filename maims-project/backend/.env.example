# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database - PostgreSQL (required)
# Either a single URL (hosted providers inject this automatically)...
DATABASE_URL=postgresql://maims_user:maims_password@127.0.0.1:5432/maims_db
# ...or the discrete settings below (only used when DATABASE_URL is unset):
# POSTGRES_DB=maims_db
# POSTGRES_USER=maims_user
# POSTGRES_PASSWORD=maims_password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Stripe Keys (get from https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# REQUIRED in production: webhook signing secret (Stripe Dashboard -> Developers -> Webhooks).
# Without it, /api/v1/stripe-webhook/ refuses all requests (unsigned events are rejected).
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Email (optional)
# When EMAIL_HOST_USER/PASSWORD are empty the console email backend is used
# instead, so order notifications are printed to the log rather than crashing.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
# Where "new order" notifications are delivered. Empty = notifications disabled.
ADMIN_RECEIVER_EMAIL=orders@your-domain.com

# --- Optional tuning ---------------------------------------------------------
# DEBUG | WARNING | ERROR. Controls the app's own log volume.
LOG_LEVEL=INFO
# Serve uploaded product photos from the app when DEBUG is False. Set to False
# once images live in S3/Cloudinary and MEDIA_URL points at the bucket.
SERVE_MEDIA=True
# Days an auth token stays valid before the API rejects and deletes it.
AUTH_TOKEN_MAX_AGE_DAYS=90
# Seconds to keep a database connection alive between requests. 0 closes it
# after every request; 60 is a reasonable production default.
DB_CONN_MAX_AGE=0

# --- Order notifications ----------------------------------------------------
# Absolute URLs used in order emails/WhatsApp messages. Without these the
# "review your order" and "leave a review" links are bare paths and unusable.
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
# Where the new-order alert goes when Store settings has no notification_email.
ADMIN_RECEIVER_EMAIL=orders@your-domain.com

# --- Facebook Page product sync -------------------------------------------
# Numeric Page ID and a Page Access Token (pages_read_engagement +
# pages_manage_posts). Both can also be set in Admin → Store settings.
FACEBOOK_PAGE_ID=123456789012345
FACEBOOK_PAGE_ACCESS_TOKEN=EAAG...your-page-token
# App secret from developers.facebook.com → Your App → Settings → Basic.
# Enables HMAC signature checks on webhook deliveries (recommended).
FACEBOOK_APP_SECRET=your-app-secret
# Token Meta checks when registering the webhook URL. Any strong random string.
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME — re-hosts Facebook post
# photos on Cloudinary so image links never expire. Leave empty to keep
# photos on the default Django storage (local disk / S3).
CLOUDINARY_URL=
# Category Facebook-synced products land in (auto-created on first sync).
FACEBOOK_SYNC_CATEGORY_SLUG=facebook-sync
# Opening stock for a newly synced product.
FACEBOOK_SYNC_DEFAULT_STOCK=10
# Currency for "price: 2500" lines that carry no currency symbol.
FACEBOOK_SYNC_DEFAULT_CURRENCY=EUR
